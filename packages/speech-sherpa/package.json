{
  "name": "tinkerdesk-provider-speech-sherpa",
  "version": "0.1.2",
  "description": "TinkerDesk 插件：本地离线语音 STT + TTS（Sherpa-ONNX）",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./core": "./core/index.js"
  },
  "scripts": {
    "pack": "node scripts/pack.js",
    "verify": "node scripts/verify.js"
  },
  "dependencies": {
    "node-cpal": "0.1.1",
    "sherpa-onnx-node": "1.13.4"
  },
  "overrides": {
    "sherpa-onnx-darwin-arm64": "1.13.4",
    "sherpa-onnx-darwin-x64": "1.13.4",
    "sherpa-onnx-linux-arm64": "1.13.4",
    "sherpa-onnx-linux-x64": "1.13.4",
    "sherpa-onnx-win-x64": "1.13.4",
    "sherpa-onnx-win-ia32": "1.13.4"
  },
  "files": [
    "index.js",
    "manifest.json",
    "core/",
    "scripts/",
    "guide.md",
    "README.md"
  ],
  "keywords": [
    "stt",
    "tinkerdesk-provider",
    "tts",
    "voice"
  ],
  "publishConfig": {
    "access": "public"
  }
}